# ==========================================
# SurakshaAI - Git Ignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/

# Build / Production
dist/
dist-ssr/
build/
.vite/

# Environment Variables - NEVER COMMIT
.env
.env.*
**/.env
**/.env.*

# Allow example environment files
!.env.example
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local / temporary files
*.local
*.tmp
*.temp

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/

# OS files
.DS_Store
Thumbs.db

# Windows
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing / Coverage
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/

# Vite
vite.config.*.timestamp-*